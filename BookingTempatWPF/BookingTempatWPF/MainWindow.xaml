<Window x:Class="BookingTempatWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem Informasi Booking Tempat" Height="760" Width="1240"
        MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#172B4D" Padding="22">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="BOOKING TEMPAT" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Sistem penyewaan tempat dan persetujuan admin" Foreground="#C8D5EB" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="WPF • C# • SQLite" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1" Margin="14">
            <TabItem Header="Buat Booking">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Formulir Pemesanan" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,12"/>
                                <TextBlock Text="Nama pemesan"/>
                                <TextBox x:Name="CustomerNameBox"/>
                                <TextBlock Text="Nomor telepon"/>
                                <TextBox x:Name="PhoneBox"/>
                                <TextBlock Text="Tempat yang dipesan"/>
                                <ComboBox x:Name="RoomCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                                <TextBlock Text="Nama acara"/>
                                <TextBox x:Name="EventNameBox"/>
                                <TextBlock Text="Jumlah peserta"/>
                                <TextBox x:Name="ParticipantsBox" Text="10"/>
                                <TextBlock Text="Waktu mulai"/>
                                <DatePicker x:Name="StartDatePicker" Margin="4"/>
                                <ComboBox x:Name="StartTimeCombo"/>
                                <TextBlock Text="Waktu selesai"/>
                                <DatePicker x:Name="EndDatePicker" Margin="4"/>
                                <ComboBox x:Name="EndTimeCombo"/>
                                <Button Content="Ajukan Booking" Background="#2457C5" Foreground="White" FontWeight="SemiBold" Click="CreateBooking_Click"/>
                                <TextBlock x:Name="BookingMessage" TextWrapping="Wrap" Margin="5,8,5,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Daftar Tempat Tersedia" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,12"/>
                                <DataGrid x:Name="RoomsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          Height="370" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nama Tempat" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Lokasi" Binding="{Binding Location}" Width="*"/>
                                        <DataGridTextColumn Header="Kapasitas" Binding="{Binding Capacity}" Width="85"/>
                                        <DataGridTextColumn Header="Tarif/Jam" Binding="{Binding PricePerHour, StringFormat={}{0:C0}}" Width="110"/>
                                        <DataGridTextColumn Header="Fasilitas" Binding="{Binding Facilities}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Pilih tempat pada formulir di sebelah kiri. Semua pengajuan masuk ke status Pending sampai admin memutuskan." 
                                           TextWrapping="Wrap" Foreground="#596579" Margin="5,14,5,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Kelola Booking (Admin)">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Daftar Pengajuan Booking" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ComboBox x:Name="StatusFilter" Width="140" SelectionChanged="StatusFilter_SelectionChanged"/>
                            <Button Content="Muat Ulang" Click="Refresh_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="BookingsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode" Binding="{Binding BookingCode}" Width="175"/>
                            <DataGridTextColumn Header="Pemesan" Binding="{Binding CustomerName}" Width="140"/>
                            <DataGridTextColumn Header="Tempat" Binding="{Binding RoomName}" Width="150"/>
                            <DataGridTextColumn Header="Acara" Binding="{Binding EventName}" Width="150"/>
                            <DataGridTextColumn Header="Mulai" Binding="{Binding StartAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135"/>
                            <DataGridTextColumn Header="Selesai" Binding="{Binding EndAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135"/>
                            <DataGridTextColumn Header="Peserta" Binding="{Binding ParticipantCount}" Width="70"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:C0}}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                            <DataGridTextColumn Header="Catatan" Binding="{Binding DecisionNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Setujui" Background="#16804A" Foreground="White" Click="Approve_Click"/>
                        <Button Content="Tolak" Background="#B42318" Foreground="White" Click="Reject_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Kelola Tempat">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <StackPanel Background="White" Margin="0,0,12,0">
                        <TextBlock Text="Tambah / Edit Tempat" FontSize="20" FontWeight="SemiBold" Margin="12"/>
                        <TextBlock Text="Pilih baris pada tabel untuk mengedit. ID 0 berarti tempat baru." Margin="12,0"/>
                        <TextBlock Text="Nama tempat"/><TextBox x:Name="RoomNameBox"/>
                        <TextBlock Text="Lokasi"/><TextBox x:Name="RoomLocationBox"/>
                        <TextBlock Text="Kapasitas"/><TextBox x:Name="RoomCapacityBox"/>
                        <TextBlock Text="Tarif per jam (Rp)"/><TextBox x:Name="RoomPriceBox"/>
                        <TextBlock Text="Fasilitas (pisahkan dengan koma)"/><TextBox x:Name="RoomFacilitiesBox"/>
                        <CheckBox x:Name="RoomActiveCheck" Content="Tempat aktif / dapat dipesan" IsChecked="True" Margin="8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Simpan Tempat" Background="#2457C5" Foreground="White" Click="SaveRoom_Click"/>
                            <Button Content="Form Baru" Click="NewRoom_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="RoomMessage" Margin="8" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid x:Name="ManageRoomsGrid" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionChanged="ManageRoomsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Lokasi" Binding="{Binding Location}" Width="*"/>
                            <DataGridTextColumn Header="Kapasitas" Binding="{Binding Capacity}" Width="80"/>
                            <DataGridTextColumn Header="Tarif/Jam" Binding="{Binding PricePerHour, StringFormat={}{0:C0}}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

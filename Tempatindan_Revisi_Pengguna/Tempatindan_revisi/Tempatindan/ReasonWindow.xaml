<Window x:Class="Tempatindan.ReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alasan Penolakan" Height="230" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Masukkan alasan penolakan (wajib):" Margin="4"/>
        <TextBox x:Name="ReasonBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Batal" Click="Cancel_Click"/>
            <Button Content="Simpan Penolakan" Background="#B42318" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

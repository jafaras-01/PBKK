<Window x:Class="Tempatindan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempatindan | Booking Tempat"
        Height="800" Width="1320" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA" FontFamily="Segoe UI" FontSize="13"
        Foreground="#20243A">

    <Window.Resources>
        <!-- Rich Minimal palette -->
        <SolidColorBrush x:Key="Ink" Color="#171A2B"/>
        <SolidColorBrush x:Key="Muted" Color="#858BA0"/>
        <SolidColorBrush x:Key="Accent" Color="#6657E8"/>
        <SolidColorBrush x:Key="AccentLight" Color="#F0EEFF"/>
        <SolidColorBrush x:Key="Line" Color="#E8EAF2"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Page" Color="#F5F6FA"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E8EAF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#171A2B"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#20243A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#858BA0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#626A80"/>
            <Setter Property="Margin" Value="3,10,3,3"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Margin" Value="3,2,3,4"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Background" Value="#FBFBFE"/>
            <Setter Property="Foreground" Value="#20243A"/>
            <Setter Property="BorderBrush" Value="#E3E5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#6657E8"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Margin" Value="3,2,3,4"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="#FBFBFE"/>
            <Setter Property="Foreground" Value="#20243A"/>
            <Setter Property="BorderBrush" Value="#E3E5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Margin" Value="3,2,3,4"/>
            <Setter Property="Background" Value="#FBFBFE"/>
            <Setter Property="Foreground" Value="#20243A"/>
            <Setter Property="BorderBrush" Value="#E3E5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#F0EEFF"/>
            <Setter Property="Foreground" Value="#5849D6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#6657E8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#16845B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D94848"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="17,12"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Foreground" Value="#858BA0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F0EEFF"/>
                                <Setter Property="Foreground" Value="#5849D6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#30364B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFD"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EFF0F5"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F6F6FB"/>
            <Setter Property="Foreground" Value="#747A90"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E9EAF1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#626A80"/>
            <Setter Property="Margin" Value="5,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#171A2B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="22,25,18,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="13"
                                Background="#6657E8" Margin="0,0,12,0">
                            <TextBlock Text="T" FontSize="24" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tempatindan" FontSize="17"
                                       FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="BOOKING PLATFORM" FontSize="9"
                                       FontWeight="SemiBold" Foreground="#A4A8BC"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="14,10,14,0">
                    <TextBlock Text="MENU UTAMA" Foreground="#777D96"
                               FontSize="10" FontWeight="Bold"
                               Margin="12,0,0,12"/>

                    <Button x:Name="NavBookingButton" Background="#302B55" Foreground="White"
                            BorderThickness="0" Padding="12" HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,7" Click="NavigateBooking_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="01" Foreground="#BFB7FF" FontSize="11" FontWeight="Bold" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Buat Reservasi" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavHistoryButton" Background="Transparent" Foreground="#D0D3E0"
                            BorderThickness="0" Padding="12" HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,7" Click="NavigateHistory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="02" Foreground="#8D93AB" FontSize="11" FontWeight="Bold" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Riwayat Booking" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRoomsButton" Background="Transparent" Foreground="#D0D3E0"
                            BorderThickness="0" Padding="12" HorizontalContentAlignment="Stretch"
                            Click="NavigateRooms_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="03" Foreground="#8D93AB" FontSize="11" FontWeight="Bold" Width="30" VerticalAlignment="Center"/>
                            <TextBlock Text="Daftar Ruangan" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="WORKSPACE" Foreground="#777D96"
                               FontSize="10" FontWeight="Bold"
                               Margin="12,30,0,12"/>
                    <Border Background="#22263A" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Booking management"
                                       Foreground="#D0D3E0" FontSize="11"/>
                            <TextBlock Text="Kelola pemesanan tempat dengan mudah."
                                       Foreground="#8D93AB" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#303449" BorderThickness="0,1,0,0"
                        Padding="20,17">
                    <StackPanel>
                        <TextBlock Text="TEMPATINDAN" Foreground="#A4A8BC"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Reservation workspace"
                                   Foreground="#777D96" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1" Margin="25,22,25,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Margin="2,0,2,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Workspace / Booking"
                               Foreground="#858BA0" FontSize="11"/>
                    <TextBlock Text="Booking ruangan dengan mudah"
                               Style="{StaticResource PageTitle}" Margin="0,5,0,0"/>
                    <TextBlock Text="Pilih ruangan, atur jadwal, dan pantau riwayat booking."
                               Style="{StaticResource SubTitle}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="White" BorderBrush="#E8EAF2"
                        BorderThickness="1" CornerRadius="12" Padding="14,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#21A67A"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Workspace aktif" Foreground="#555D72"
                                   FontWeight="SemiBold" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Halaman aplikasi pengguna -->
            <TabControl x:Name="MainTabs" Grid.Row="1">

                <TabItem Header="Buat Reservasi">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.92*"/>
                                <ColumnDefinition Width="1.45*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Buat reservasi baru"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Isi detail pemesanan tempat di bawah ini."
                                               Style="{StaticResource SubTitle}" Margin="0,0,0,8"/>

                                    <TextBlock Text="Nama pemesan" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CustomerNameBox"/>

                                    <TextBlock Text="Nomor telepon" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PhoneBox"/>

                                    <TextBlock Text="Tempat yang dipesan" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="RoomCombo" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"/>

                                    <TextBlock Text="Nama acara" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EventNameBox"/>

                                    <TextBlock Text="Jumlah peserta" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ParticipantsBox" Text="10"/>

                                    <TextBlock Text="Waktu mulai" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="StartDatePicker"/>
                                    <ComboBox x:Name="StartTimeCombo"/>

                                    <TextBlock Text="Waktu selesai" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="EndDatePicker"/>
                                    <ComboBox x:Name="EndTimeCombo"/>

                                    <Button Content="Ajukan Booking"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="3,15,3,3"
                                            Click="CreateBooking_Click"/>

                                    <TextBlock x:Name="BookingMessage"
                                               TextWrapping="Wrap" Margin="4,8,4,0"
                                               Foreground="#6657E8"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}"
                                    Margin="10,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Tempat yang tersedia"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Grid.Row="1"
                                               Text="Bandingkan lokasi, kapasitas, dan fasilitas tempat."
                                               Style="{StaticResource SubTitle}" Margin="0,0,0,4"/>

                                    <DataGrid x:Name="RoomsGrid" Grid.Row="2"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" Height="370"
                                              SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nama Tempat" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Lokasi" Binding="{Binding Location}" Width="*"/>
                                            <DataGridTextColumn Header="Kapasitas" Binding="{Binding Capacity}" Width="85"/>
                                            <DataGridTextColumn Header="Fasilitas" Binding="{Binding Facilities}" Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="3" Background="#F4F2FF"
                                            CornerRadius="10" Padding="12" Margin="0,14,0,0">
                                        <TextBlock Text="Booking yang berhasil dibuat langsung tercatat di riwayat. Jadwal yang bentrok akan ditolak otomatis."
                                                   Foreground="#6558C9" FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Riwayat Booking">
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Riwayat pemesanan"
                                               Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Lihat status dan detail booking yang pernah diajukan."
                                               Style="{StaticResource SubTitle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ComboBox x:Name="StatusFilter" Width="150"
                                              SelectionChanged="StatusFilter_SelectionChanged"/>
                                    <Button Content="Muat Ulang" Click="Refresh_Click"
                                            Margin="6,2,0,2"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="BookingsGrid" Grid.Row="1"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kode" Binding="{Binding BookingCode}" Width="175"/>
                                    <DataGridTextColumn Header="Pemesan" Binding="{Binding CustomerName}" Width="140"/>
                                    <DataGridTextColumn Header="Tempat" Binding="{Binding RoomName}" Width="150"/>
                                    <DataGridTextColumn Header="Acara" Binding="{Binding EventName}" Width="150"/>
                                    <DataGridTextColumn Header="Mulai" Binding="{Binding StartAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135"/>
                                    <DataGridTextColumn Header="Selesai" Binding="{Binding EndAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135"/>
                                    <DataGridTextColumn Header="Peserta" Binding="{Binding ParticipantCount}" Width="70"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                    <DataGridTextColumn Header="Catatan" Binding="{Binding DecisionNote}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>


                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Daftar Ruangan">
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Daftar ruangan" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Informasi ruangan aktif yang dapat dipilih untuk booking." Style="{StaticResource SubTitle}"/>
                                <Button Content="Muat Ulang" Click="Refresh_Click" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            </StackPanel>
                            <DataGrid x:Name="AllRoomsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nama Ruangan" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Lokasi" Binding="{Binding Location}" Width="*"/>
                                    <DataGridTextColumn Header="Kapasitas" Binding="{Binding Capacity}" Width="100"/>
                                    <DataGridTextColumn Header="Fasilitas" Binding="{Binding Facilities}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
